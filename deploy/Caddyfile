# Caddy, Nabız'ın önünde: HTTPS sertifikası ve sıkıştırma. Erişim log'u açık değil
# (Caddy varsayılan olarak tutmaz); IP adresleri hiçbir yere yazılmaz.
nabiz.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8081 {
		# Proxy üzerinden (ör. Vercel) gelen istekte ziyaretçinin adresi gelen
		# X-Forwarded-For'dadır. Onu koruyup sonuna bağlanan adresi ekliyoruz:
		# Nabız sayım için ilk değeri, hız sınırı için son değeri kullanır
		# (docs/proxy.md). Ayar sadece bu sitede; aynı Caddy'deki başka
		# uygulamaların başlıklarına dokunmaz.
		header_up X-Forwarded-For "{http.request.header.X-Forwarded-For}, {http.request.remote.host}"
	}
}
