# /etc/nabiz/nabiz.env örneği. Gerçek dosya: sudo install -m 0600 -o root /dev/null /etc/nabiz/nabiz.env
# Bu dosya örnektir; gerçek değerleri asla repoya koyma.

# Mod: selfhost (paket ve sınır yok) ya da cloud (herkese açık kayıt + Ücretsiz paket sınırları).
NABIZ_MODE=selfhost
# E-postalardaki bağlantılar için sitenin adresi.
NABIZ_BASE_URL=https://nabiz.example.com
# selfhost modunda herkese açık kayıt (cloud modunda her zaman açık).
NABIZ_SIGNUP=0
# Tanıtım sayfasında canlı nabzı gösterilecek, herkese açık bir site (isteğe bağlı).
NABIZ_DEMO_SITE=
# cloud modunda sınırsız kullanacak işletmeci hesapları (virgülle ayrılmış e-postalar).
NABIZ_ADMIN_EMAILS=

# E-posta (doğrulama, şifre sıfırlama, davet). Boşsa e-postalar sadece log'a yazılır.
NABIZ_SMTP_HOST=
NABIZ_SMTP_PORT=587
NABIZ_SMTP_USER=
NABIZ_SMTP_PASS=
NABIZ_SMTP_FROM=Nabız <bildirim@example.com>

# Ücretli paketler (isteğe bağlı, sadece cloud modunda; iyzico üye işyeri hesabı gerekir).
# Hepsi boşsa ödeme kapalıdır.
NABIZ_IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
NABIZ_IYZICO_API_KEY=
NABIZ_IYZICO_SECRET_KEY=
NABIZ_IYZICO_MERCHANT_ID=
NABIZ_IYZICO_PLAN_STARTER_MONTHLY=
NABIZ_IYZICO_PLAN_STARTER_YEARLY=
NABIZ_IYZICO_PLAN_GROWTH_MONTHLY=
NABIZ_IYZICO_PLAN_GROWTH_YEARLY=
# Ödeme açıksa alıcıya gösterilecek kendi sözleşmelerin (https://).
NABIZ_SALES_CONTRACT_URL=
NABIZ_PRE_INFO_URL=
